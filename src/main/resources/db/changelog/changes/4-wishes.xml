<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-wishes" author="dellya">
        <createTable tableName="wishes">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="price" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="bigint"/>
            <column name="wish_group_id" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="wishes"
                baseColumnNames="owner_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_wishes_owner"/>

        <addForeignKeyConstraint
                baseTableName="wishes"
                baseColumnNames="category_id"
                referencedTableName="categories"
                referencedColumnNames="id"
                constraintName="fk_wishes_category"/>

        <addForeignKeyConstraint
                baseTableName="wishes"
                baseColumnNames="wish_group_id"
                referencedTableName="wish_groups"
                referencedColumnNames="id"
                constraintName="fk_wishes_group"/>
    </changeSet>

</databaseChangeLog>
